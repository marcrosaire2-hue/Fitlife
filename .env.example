# Copier ce fichier en .env (jamais commité) et renseigner la vraie chaîne de connexion MongoDB.
MONGODB_URI=mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=fitpulse

# Administrateurs (facultatif) : adresses e-mail séparées par des virgules. Ils peuvent créer des défis « officiels »
# et supprimer n'importe quel défi ou publication.
ADMIN_EMAILS=

# Images (photos de profil, images publiées par l'administrateur) : Supabase Storage. Crée un projet Supabase, puis copie « Project URL » et la clé « service_role »
# (Project Settings > API). La clé service_role donne un accès total : elle ne doit jamais être commitée ni envoyée au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=fitlife
# Adresse publique des images, lue aussi par le site (Vite) : même valeur que SUPABASE_URL + /storage/v1/object/public/<bucket>
# À renseigner APRÈS « npm run migrate:media » (sinon les photos locales restent utilisées) :
# VITE_ASSETS_BASE=https://<ref>.supabase.co/storage/v1/object/public/fitlife

# Appels vidéo (WebRTC) : serveurs STUN/TURN au format JSON. Sans TURN, certains réseaux (entreprise, 4G stricte) bloquent l'appel.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.exemple.com:3478","username":"…","credential":"…"}]
# Origines supplémentaires autorisées pour le WebSocket (séparées par des virgules) si le site est servi depuis un autre domaine.
# ALLOWED_ORIGINS=
